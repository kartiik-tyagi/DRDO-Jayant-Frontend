{
  "header": {
    "visible": true,
    "height": 64,
    "showLogo": true,
    "showTitle": true,
    "showClock": true,
    "showUser": true,
    "userLabel": "Exercise controller"
  },
  "topbar": {
    "visible": true,
    "height": 44,
    "items": [
      { "id": "classification", "label": "{scenario.classification}", "color": "warning" },
      { "id": "exercise", "label": "{scenario.name}", "color": "default" },
      { "id": "phase", "label": "Phase: {scenario.phase}", "color": "info" },
      { "id": "network", "label": "Offline", "color": "success" }
    ]
  },
  "sidebar": {
    "visible": true,
    "width": 268,
    "collapsedWidth": 76,
    "defaultCollapsed": false
  },
  "footer": {
    "visible": true,
    "height": 32,
    "text": "Sample exercise data. Map layers come from the GIS server in public/config/map.json."
  },
  "contentPadding": 16
}
